{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],

    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,

    "baseUrl": ".",
    "paths": {
      "@electron/*": ["electron/*"],
      "@main/*": ["src/main/*"],
      "@renderer/*": ["src/renderer/*"],
      "@modules/*": ["modules/*"]
    },

    "types": ["node"]
  },
  "include": [
    "src/renderer/**/*",
    "modules/**/*",
    "electron/**/*.d.ts",
    "vite.config.*",
    "vitest.config.*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist-electron",
    "build",
    "src/main/**/*",
    "electron/**/*"
  ]
}
