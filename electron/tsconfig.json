{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],

    "module": "CommonJS",
    "moduleResolution": "node",

    "rootDir": "..",
    "outDir": "../dist-electron",

    "baseUrl": "..",
    "paths": {
      "@main/*": ["src/main/*"],
      "@modules/*": ["modules/*"],
      "@electron/*": ["electron/*"]
    },

    "noEmit": false,
    "noEmitOnError": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["../electron/**/*", "../src/main/**/*", "../modules/**/*"],
  "exclude": ["../src/renderer/**/*", "../node_modules", "../dist", "../dist-electron"]
}
